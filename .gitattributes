# 统一换行，避免 Windows/Linux 协作时整文件 diff
* text=auto eol=lf

# 明确二进制，防止 git 做文本转换损坏文件
*.png   binary
*.jpg   binary
*.jpeg  binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.3mf   binary
*.ttf   binary
*.otf   binary

# 让 GitHub 语言统计把 libslic3r 视作 C++（否则可能被 CMake 抢走）
*.cpp   linguist-language=C++
*.hpp   linguist-language=C++
*.h     linguist-language=C++
*.c     linguist-language=C++

# 第三方源码树在 diff/统计里折叠
entry/src/main/cpp/libslic3r/third_party/** linguist-vendored
entry/src/main/cpp/mbedtls/**               linguist-vendored
entry/src/main/cpp/paho/**                  linguist-vendored
