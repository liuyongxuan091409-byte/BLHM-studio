// 英文串 → 中文；查不到返回原串（宁可英文，也不编）
const ZH: Map<string, string> = (() => {
  const m: Map<string, string> = new Map<string, string>();
  for (let i = 0; i + 1 < PARAM_ZH_PAIRS.length; i += 2) {
    m.set(PARAM_ZH_PAIRS[i], PARAM_ZH_PAIRS[i + 1]);
  }
  return m;
})();

export function zhOf(en: string): string {
  if (en.length === 0) { return en; }
  const v: string | undefined = ZH.get(en);
  return v !== undefined ? v : en;
}
